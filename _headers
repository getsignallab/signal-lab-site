/*.png
  Cache-Control: public, max-age=31536000
/*.webp
  Cache-Control: public, max-age=31536000
/*.ico
  Cache-Control: public, max-age=31536000
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Propuesta de cliente en preparación: no indexar hasta el lanzamiento autorizado
/yeilis-ar-beauty/*
  X-Robots-Tag: noindex, nofollow
